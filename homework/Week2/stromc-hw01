def validate_point(name, point):
    errors = []

    if not isinstance(point, list):
            errors.append(f"{name} is not a list.")
    elif not isinstance(point, list):
            errors.append(f"{name} is not a list.")
    elif len(point) != 2:
            errors.append(f"{name} must contain exactly 2 values.")
    else:
        for i, value in enumerate(point):
            if not isinstance(value, (float, int)):
                errors.append(f"{name} is not numeric: {value!r}")
        
    return errors

